HOST=127.0.0.1
PORT=8787
# bridge (independent endpoints), disabled, or explicitly coze
AI_PROVIDER=bridge

# Optional: configure later with AI_PROVIDER=coze. Do not share tokens in chat or commit .env.
# COZE_API_TOKEN=
# COZE_RECOGNITION_WORKFLOW_ID=
# COZE_SEARCH_WORKFLOW_ID=
# COZE_BOT_ID=

# Alternative custom bridges. Used only with AI_PROVIDER=bridge.
# RECOGNITION_BRIDGE_URL=https://your-service.example/recognize
# SEARCH_BRIDGE_URL=https://your-service.example/search
# AI_BRIDGE_TOKEN=
# Direct BigModel API, optional: set AI_PROVIDER=bigmodel to enable.
# Select actual models available in your account; do not assume all model names work.
# BIGMODEL_API_KEY=
# BIGMODEL_VISION_MODEL=
# BIGMODEL_TEXT_MODEL=
# BIGMODEL_SEARCH_ENGINE=search_std


# Safety gates for the actual server entry point. Defaults: no external AI calls.
EXTERNAL_AI_ENABLED=false
AI_RECOGNITION_MONTHLY_LIMIT=0
AI_SEARCH_MONTHLY_LIMIT=0
AI_MODEL_MONTHLY_LIMIT=0
AI_WORKFLOW_MONTHLY_LIMIT=0
# Local counters do not know remaining vendor free quota or usage by other apps.

# Optional Doubao Custom search instead of BigModel search:
# SEARCH_PROVIDER=volc
# VOLC_SEARCH_API_KEY=
# Search retrieval uses Volc; extraction still requires BIGMODEL_API_KEY + TEXT_MODEL.
