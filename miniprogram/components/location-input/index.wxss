.location-box{position:relative}input{box-sizing:border-box;width:100%;background:#f2eef5;color:#24212b;border-radius:18rpx;padding:22rpx;height:92rpx;font-size:28rpx}.suggestions{position:absolute;top:102rpx;left:0;right:0;z-index:50;max-height:460rpx;overflow-y:auto;background:#fff;border:1rpx solid #e7ddf3;border-radius:20rpx;box-shadow:0 12rpx 40rpx #24212b18}.option{display:flex;flex-direction:column;gap:6rpx;padding:18rpx 24rpx;font-size:27rpx;border-bottom:1rpx solid #f2eef5}.option:active{background:#eee7fb}.area-label{font-size:21rpx;color:#817988}.custom{color:#7047eb;background:#faf7ff;font-size:24rpx}
