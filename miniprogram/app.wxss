page{background:#fbf8f4;color:#24212b;font-family:system-ui,-apple-system,sans-serif;font-size:28rpx}view,text,button,input{box-sizing:border-box}.page{padding:48rpx 36rpx 80rpx}.eyebrow{font-size:22rpx;letter-spacing:4rpx;color:#77717f}.title{font-size:56rpx;font-weight:800;line-height:1.25;margin:22rpx 0}.subtitle,.muted{color:#77717f;line-height:1.7}.card{background:#fff;border-radius:32rpx;padding:32rpx;margin:24rpx 0;border:1rpx solid #ece6ef}.primary{background:#7047eb;color:#ffffff;border-radius:24rpx;font-weight:700;margin-top:24rpx}.secondary{background:#fff;border:1rpx solid #ddd5e6;border-radius:24rpx;margin-top:20rpx}button::after{border:0}.pill{display:inline-block;background:#eee7fb;padding:10rpx 18rpx;border-radius:99rpx;font-size:22rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:20rpx}.price{font-size:44rpx;font-weight:800}.field{margin:28rpx 0}.label{display:block;font-size:24rpx;color:#77717f;margin-bottom:14rpx}input{background:#f2eef5;border-radius:18rpx;padding:22rpx;height:92rpx}.photo{width:100%;height:350rpx;border-radius:24rpx;background:#eee8f1}.notice{font-size:24rpx;color:#77717f;line-height:1.7;padding:20rpx 0}.empty{text-align:center;padding:80rpx 20rpx}.link{color:#6840d6;text-align:center;padding:24rpx}.divider{height:1rpx;background:#ece6ef;margin:24rpx 0}
.primary[disabled]{background:#e5ddf3;color:#8b809c}.coral{color:#bc443d}.secondary{color:#4b3a66}.pill{color:#6543b5}
.place-toggle{display:flex;justify-content:space-between;padding:24rpx 0;font-size:26rpx;border-bottom:1rpx solid #e8e0ec}.place-toggle text{font-size:22rpx;color:#77717f}.scene-options{display:flex;gap:14rpx;flex-wrap:wrap}.scene-chip{padding:14rpx 22rpx;background:#f2eef5;color:#6d617c;border-radius:99rpx;font-size:24rpx}.scene-selected{background:#7047eb;color:white}.place-line{font-size:24rpx;color:#77717f;line-height:1.7;margin-top:12rpx}

.city-picker{display:flex;align-items:center;justify-content:space-between;gap:20rpx;min-height:92rpx;padding:22rpx;background:#f2eef5;border-radius:18rpx}.city-picker .muted{font-size:24rpx;flex-shrink:0}

.location-field{position:relative}.location-suggestions{margin-top:12rpx;max-height:420rpx;overflow-y:auto;background:white;border:1rpx solid #e7ddf3;border-radius:18rpx}.location-option{display:flex;flex-direction:column;gap:6rpx;padding:16rpx 22rpx;border-bottom:1rpx solid #f2eef5;font-size:26rpx}.location-option:active{background:#eee7fb}.location-hint{font-size:21rpx;color:#817988}.location-custom{color:#7047eb;background:#faf7ff;font-size:24rpx}

.location-suggestions{max-height:190px;box-sizing:border-box}.location-suggestions .location-option{min-height:44px;box-sizing:border-box}
