page{background:#24212b;color:#fff}.capture{height:100vh;display:flex;flex-direction:column}.viewfinder{width:100%;height:65vh}.capture-controls{text-align:center;padding:30rpx 36rpx;padding-bottom:calc(24rpx + env(safe-area-inset-bottom));font-size:26rpx}.shutter{border-radius:99rpx;width:132rpx;height:132rpx;line-height:132rpx;padding:0;margin:24rpx auto;background:#fff;color:#7047eb;font-weight:700}.album{padding:14rpx}.camera-error{height:60vh;display:flex;flex-direction:column;justify-content:center;padding:50rpx;text-align:center;font-size:36rpx}.camera-error text{font-size:26rpx;color:#ccc3d8;line-height:1.8;margin-top:24rpx}