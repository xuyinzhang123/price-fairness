<view class="page"><view class="eyebrow">LOCAL PRICE NOTES</view><view class="title">同城都花多少钱</view><view class="subtitle">搜个名称，看看同城大家花了多少。</view>
<view class="card"><view class="field"><text class="label">城市 / 县 / 区</text><view class="location-field"><input value="{{city}}" placeholder="直接输入城市、县或区，例如：德清" maxlength="80" bindinput="cityInput" bindfocus="cityFocus" bindblur="cityBlur" bindconfirm="cityConfirm" confirm-type="done"/><view wx:if="{{citySuggestionsOpen&&city}}" class="location-suggestions"><view wx:for="{{citySuggestions}}" wx:key="value" class="location-option" data-value="{{item.value}}" catchtap="cityPick"><text>{{item.value}}</text><text class="location-hint">{{item.label}}</text></view><view class="location-option location-custom" data-value="{{city}}" catchtap="cityPick">直接使用“{{city}}”</view></view></view></view><view class="field"><text class="label">商品或服务名称（选填）</text><input value="{{name}}" placeholder="例如：蛋炒饭、全季酒店" bindinput="nameChange" bindconfirm="search" confirm-type="search"/></view><button class="secondary" bindtap="search" loading="{{loading}}">查查大家的报价</button></view><view class="notice">{{cloud?'公开晒价和我的记录 · 点击卡片查看':'本机预览 · 这里仅展示这台设备保存的记录'}}</view>
<view wx:if="{{error}}" class="notice">{{error}}</view><view wx:if="{{!items.length&&!loading&&!error}}" class="empty"><view>{{!searched?'先选一个城市':name?'暂时没有这个名称的公开晒价':'这个城市暂时没有公开晒价'}}</view><view class="muted">{{searched?'换个名称试试，或晒出你的价格。':'填名称可以找同城的相关报价。'}}</view><button class="primary" bindtap="camera">去晒个价</button></view>
<view wx:for="{{items}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="detail"><image wx:if="{{item.image}}" src="{{item.image}}" class="photo" mode="aspectFill"/><view class="row"><text>{{item.name}}</text><text class="price">¥{{item.price}}</text></view><view wx:if="{{cloud&&item.isOwn&&!item.cityVisible}}" class="pill">我的记录 · 未公开同城</view><view class="notice">{{item.city}} · {{item.priceType==='paid'?'实际支付':'看到的报价'}}</view><view wx:if="{{item.placeName||item.scene}}" class="place-line">{{item.placeName}} {{item.scene}}</view><view wx:if="{{item.note}}">{{item.note}}</view><button class="secondary" data-name="{{item.name}}" data-city="{{item.city}}" data-id="{{item.id}}" catchtap="quote">我也晒个价</button></view></view>