page{height:100%;overflow:hidden}.result-page{height:100vh;box-sizing:border-box;padding:22rpx 32rpx;padding-bottom:calc(18rpx + env(safe-area-inset-bottom));display:flex;flex-direction:column;overflow:hidden;gap:10rpx}.result-header{flex-shrink:0}.result-heading{font-size:42rpx;font-weight:800;margin:8rpx 0}.eyebrow{font-size:20rpx}.status{flex-shrink:0;font-size:22rpx;color:#77717f;line-height:1.4}.card-stage{flex:1;min-height:0;position:relative;display:flex;align-items:center;justify-content:center}.card-image{width:100%;height:100%}.card-placeholder{font-size:26rpx;color:#77717f;text-align:center}.export-canvas{position:absolute;left:-10000px;top:0;width:360px;height:540px;pointer-events:none}.small-actions{display:flex;justify-content:space-around;padding:12rpx 0;flex-shrink:0;font-size:24rpx;color:#6840d6}.fineprint{flex-shrink:0;text-align:center;font-size:20rpx;color:#89818e;line-height:1.4}.action-bar{flex-shrink:0;display:flex;gap:16rpx;align-items:center;padding-top:8rpx}.action-bar .primary{flex:1;margin:0;font-size:28rpx}.save-button{margin:0;background:#fff;border:1rpx solid #ddd5e6;border-radius:24rpx;font-size:25rpx;padding:0 22rpx}.sheet-mask{position:fixed;inset:0;background:#24212b66;z-index:20;display:flex;align-items:flex-end}.result-sheet{width:100%;background:#fbf8f4;border-radius:32rpx 32rpx 0 0;padding:30rpx 36rpx;padding-bottom:calc(24rpx + env(safe-area-inset-bottom))}.sheet-title{display:flex;align-items:center;justify-content:space-between;font-size:32rpx;font-weight:700;margin-bottom:28rpx}.sheet-title>text:last-child{font-size:25rpx;color:#7047eb;font-weight:400}.sheet-scroll{max-height:55vh}
.mood-options{display:flex;gap:12rpx;flex-shrink:0;justify-content:center}.mood-option{flex:1;margin:0;padding:13rpx 5rpx;font-size:24rpx;line-height:1.4;border-radius:99rpx;background:#fff;color:#817988;border:1rpx solid #e6ddef}.mood-option.mood-selected{color:#7047eb;background:#eee7fb;border-color:#bba5f4}.mood-option[disabled]{opacity:.7}
