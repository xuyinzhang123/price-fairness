.sheet-mask{position:fixed;inset:0;background:#24212b66;z-index:20;display:flex;align-items:flex-end}.place-sheet{width:100%;background:#fbf8f4;border-radius:32rpx 32rpx 0 0;padding:30rpx 36rpx;padding-bottom:calc(24rpx + env(safe-area-inset-bottom))}.sheet-heading{display:flex;justify-content:space-between;align-items:center;font-size:30rpx;font-weight:700;margin-bottom:24rpx}.sheet-heading>text:last-child{font-size:25rpx;font-weight:400;color:#7047eb}.sheet-content{max-height:52vh}.sheet-content .label{margin-top:22rpx}.type-row{display:flex;align-items:center;justify-content:space-between;margin-top:24rpx}