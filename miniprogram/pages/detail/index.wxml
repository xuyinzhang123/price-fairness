<view class="page">
 <view wx:if="{{loading}}" class="notice">正在打开晒价…</view>
 <view wx:elif="{{error}}" class="card"><view>{{error}}</view><button class="secondary" bindtap="load">重新加载</button></view>
 <block wx:elif="{{post}}">
  <view class="eyebrow">这价格，冤不冤？</view><view class="title">{{post.name}}</view>
  <view class="row"><text class="pill">{{post.city}}</text><text class="price">¥{{post.price}}</text></view>
  <view class="notice">{{post.priceType==='paid'?'实际支付':'看到的报价'}} · {{post.observedAt}}</view>
  <view wx:if="{{post.placeName||post.locationHint||post.scene}}" class="card"><view>{{post.placeName||"当时购买位置"}} <text class="pill" wx:if="{{post.scene}}">{{post.scene}}</text></view><view class="place-line">{{post.locationHint}}</view><view wx:if="{{post.scene==='地摊'}}" class="notice">记录的是当时位置，摊位可能移动。</view></view><image wx:if="{{post.image}}" src="{{post.image}}" class="photo" mode="aspectFill" bindtap="preview"/>
  <view wx:if="{{post.note}}" class="card">{{post.note}}</view>
  <view class="card"><block wx:if="{{analysis.status==='ready'}}"><view class="eyebrow">冤种指数</view><view class="title">{{analysis.score}} · {{analysis.title}}</view><view class="subtitle">{{analysis.score>=81?"钱包有点委屈，找朋友评评理。":analysis.score<=20?"这单买得漂亮，值得炫耀一下。":"钱都花了，让朋友说说这价怎么样。"}}</view><view class="muted">{{analysis.count}} 条参考报价 · 中位价 ¥{{analysis.median}}</view><view class="notice">本次同城同名称参考样本，不代表全城所有商家。</view></block><view wx:else><view class="title" style="font-size:42rpx">冤不冤暂时不知道</view><view class="subtitle">先让朋友评评理，也欢迎补个价。</view></view></view>
<button class="primary" bindtap="poster">做张好看的卡片，晒朋友圈</button><button wx:if="{{cloud}}" class="secondary" open-type="share">选择微信好友分享 ↗</button>
<view wx:else class="notice">本机预览暂不能转给朋友；接入共享后台后使用分享。</view><view wx:if="{{cloud}}" class="notice">在手机微信中选择好友或群聊，确认后才会发送。</view>
  <view class="link" bindtap="toggleReferences">{{showReferences?'收起价格依据':'查看价格依据'}}</view><view wx:if="{{showReferences}}" class="card"><view>本次参考报价</view><view wx:for="{{analysis.references}}" wx:key="id"><view class="divider"/><view class="row"><text>{{item.source==='web'?'公开报价':'用户报价'}}</text><text>¥{{item.price}}</text></view><view class="place-line">{{item.placeName||"店名未提供"}} · {{item.scene||"场景未提供"}}<br/>{{item.locationHint}}</view><view class="notice">{{item.observedAt}}</view><text wx:if="{{item.url}}" selectable class="notice">{{item.url}}</text></view></view>
  <button class="secondary" bindtap="quote">我也晒个价</button>
  <view class="title" style="font-size:36rpx;margin-top:50rpx">大家怎么说</view>
  <view wx:if="{{!post.replies.length}}" class="notice">还没有人补充，你来留个参考？</view>
  <view wx:for="{{post.replies}}" wx:key="id" class="card">
   <view wx:if="{{item.price}}" class="row"><text>{{item.priceType==='paid'?'我实际花了':'我看到的价格'}}</text><text class="price">¥{{item.price}}</text></view>
   <view wx:if="{{item.price}}" class="place-line">{{item.placeName||"店名未提供"}} · {{item.scene||"场景未提供"}}<br/>{{item.locationHint}}</view><view wx:if="{{item.note}}">{{item.note}}</view><view class="notice">{{item.observedAt||item.createdAt}}</view>
  </view>
  <view class="card"><input maxlength="200" value="{{note}}" bindinput="input" placeholder="安慰一下，还是补一刀？"/><button class="secondary" bindtap="comment">说两句</button></view>
  <view class="notice">{{cloud?'体验版 · 大家的看法仅供参考。':'本机预览，记录不会同步到其他设备。'}}</view>
 </block>
</view>