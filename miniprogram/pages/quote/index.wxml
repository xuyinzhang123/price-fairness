<view class="page"><view class="title">我也晒个价</view><view class="subtitle">{{name}} · {{city}}</view>
<view class="field"><text class="label">价格 / 元</text><input type="digit" data-field="price" bindinput="change" placeholder="你看到或支付多少钱？"/></view>
<view class="field"><text class="label">说两句（选填）</text><input maxlength="200" data-field="note" bindinput="change" placeholder="例如：昨天买的，会员优惠后价格"/></view>
<view class="field"><switch color="#7047eb" checked="{{paid}}" bindchange="paidChange"/> <text>{{paid?'实际支付':'看到的报价'}}</text></view>
<view class="place-toggle" bindtap="togglePlace">在哪里买的？<text>{{showPlace?'收起 −':'选填，给下次留个线索 ＋'}}</text></view>
<view wx:if="{{showPlace}}" class="card">
 <view class="field"><text class="label">店名 / 摊位名（选填）</text><input maxlength="120" value="{{placeName}}" data-field="placeName" bindinput="change" placeholder="例如：人民路口炒饭摊"/></view>
 <view class="field"><text class="label">位置 / 附近地标（选填）</text><input maxlength="160" value="{{locationHint}}" data-field="locationHint" bindinput="change" placeholder="例如：地铁 A 口旁，记录当时位置"/></view>
 <view class="label">消费场景（选填，再点可取消）</view><view class="scene-options"><text wx:for="{{scenes}}" wx:key="*this" class="scene-chip {{scene===item?'scene-selected':''}}" data-scene="{{item}}" bindtap="sceneChange">{{item}}</text></view>
 <view class="notice">会随报价展示，请只填店铺或摊位位置，不填私人住址。</view>
</view>
<button class="primary" bindtap="submit">保存报价</button><view class="notice">{{cloud?'开发版：文字报价保存在后台。':'开发预览：仅保存在本机。'}}</view></view>