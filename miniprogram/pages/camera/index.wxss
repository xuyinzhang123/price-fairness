.home-page{padding:36rpx 32rpx 40rpx;-webkit-text-size-adjust:100%;text-size-adjust:100%}
.hero{padding:8vh 0 4vh}
.hero .home-title{font-size:72rpx;letter-spacing:-2rpx;line-height:1.25;white-space:nowrap;margin:28rpx 0 20rpx}
.stamp{width:120rpx;height:120rpx;background:#eee7fb;color:#7047eb;border-radius:34rpx;text-align:center;line-height:120rpx;font-size:56rpx;font-weight:800;transform:rotate(-10deg);margin-bottom:36rpx}
.home-page .primary{width:100%;font-size:30rpx;line-height:1.4;padding:24rpx 12rpx;margin-top:20rpx}
.alternatives{justify-content:center;gap:64rpx;padding:24rpx 12rpx;flex-wrap:wrap}
.alternatives view{padding:8rpx 4rpx}
.home-page .notice{text-align:center;margin-top:5vh;font-size:23rpx}
@media(max-height:650px){.hero{padding:5vh 0 3vh}.stamp{width:104rpx;height:104rpx;line-height:104rpx;font-size:50rpx;margin-bottom:24rpx}.home-page .notice{margin-top:2vh}}
@media(max-width:340px){.hero .home-title{font-size:68rpx}.home-page .eyebrow{font-size:20rpx;letter-spacing:2rpx}}
.home-page .eyebrow,.home-page .hero{text-align:center}
.home-page .stamp{margin-left:auto;margin-right:auto}
/* Larger tilted price stamp, offset left of the centered headline. */
.home-page .stamp{width:148rpx;height:148rpx;line-height:148rpx;font-size:70rpx;border-radius:42rpx;margin-left:56rpx;margin-right:0;margin-bottom:40rpx;transform:rotate(-12deg)}
@media(max-height:650px){.home-page .stamp{width:124rpx;height:124rpx;line-height:124rpx;font-size:60rpx;border-radius:36rpx;margin-bottom:28rpx}}
